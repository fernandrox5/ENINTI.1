PORT=3001
# Base de datos en Supabase (sin ?sslmode). Local: Session pooler (puerto 5432). En Vercel: Transaction
# pooler (puerto 6543). Caracteres especiales de la
# contraseña van codificados (ej. @ = %40)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase (API). La clave secreta solo va en el backend
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# Orígenes del frontend permitidos en producción (separados por coma). Vacío en desarrollo (proxy de Vite)
CORS_ORIGINS=

# Correo (avisos automáticos) · misma configuración que SAC. En Gmail, SMTP_PASSWORD es una
# contraseña de aplicación (Cuenta de Google > Seguridad > Contraseñas de aplicaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
# false = no envía (los avisos quedan pendientes)
MAIL_ENABLED=
# Todos los correos llegan a esta dirección (úsalo mientras los datos sean de prueba)
MAIL_REDIRECT=
# Correo del administrador que reciben los avisos (db:init lo guarda en configuracion.email_admin)
ADMIN_EMAIL=
# Secreto con que Vercel Cron llama a /api/cron/avisos (cadena larga y aleatoria)
CRON_SECRET=

# Contraseña de los usuarios de prueba que crea db:init (mínimo 8 caracteres)
DEMO_PASSWORD=

# Flow (pasarela de pago). Sandbox: https://sandbox.flow.cl/api · producción: https://www.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://sandbox.flow.cl/api
# true = el cron cobra solo cada día; false = solo con el botón "Cobrar ahora" del panel
COBROS_AUTOMATICOS=false
